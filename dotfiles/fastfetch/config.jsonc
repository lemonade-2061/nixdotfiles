{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "~/nixos/dotfiles/fastfetch/logo.jpg",
    "width": 28,
    "padding": {
      "top": 4,
      "left": 3,
      "right": 3
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "break",
    // ── System ── (foam)
    { "type": "custom",   "format": "{#38;2;156;207;216}╭────────────────────── System ──────────────────────╮" },
    { "type": "os",       "key": "│    OS       ", "keyColor": "38;2;156;207;216" },
    { "type": "kernel",   "key": "│    Kernel   ", "keyColor": "38;2;156;207;216" },
    { "type": "uptime",   "key": "│  󰅐  Uptime   ", "keyColor": "38;2;156;207;216" },
    { "type": "battery",  "key": "│  󰁹  Battery  ", "keyColor": "38;2;156;207;216" },
    { "type": "custom",   "format": "{#38;2;156;207;216}╰────────────────────────────────────────────────────╯" },
    "break",
    // ── Hardware ── (gold)
    { "type": "custom",   "format": "{#38;2;246;193;119}╭───────────────────── Hardware ─────────────────────╮" },
    { "type": "cpu",      "key": "│  󰘚  CPU      ", "keyColor": "38;2;246;193;119" },
    { "type": "gpu",      "key": "│  󰢮  GPU      ", "keyColor": "38;2;246;193;119" },
    { "type": "memory",   "key": "│  󰍛  Memory   ", "keyColor": "38;2;246;193;119" },
    { "type": "disk",     "key": "│  󰋊  Disk     ", "keyColor": "38;2;246;193;119" },
    { "type": "custom",   "format": "{#38;2;246;193;119}╰────────────────────────────────────────────────────╯" },
    "break",
    // ── Software ── (iris)
    { "type": "custom",   "format": "{#38;2;196;167;231}╭───────────────────── Software ─────────────────────╮" },
    { "type": "packages", "key": "│  󰏖  Packages ", "keyColor": "38;2;196;167;231" },
    { "type": "shell",    "key": "│  󱆃  Shell    ", "keyColor": "38;2;196;167;231" },
    { "type": "wm",       "key": "│  󰖯  WM       ", "keyColor": "38;2;196;167;231" },
    { "type": "terminal", "key": "│  󰄛  Terminal ", "keyColor": "38;2;196;167;231" },
    { "type": "custom",   "format": "{#38;2;196;167;231}╰────────────────────────────────────────────────────╯" },
    "break",
    { "type": "colors", "symbol": "circle" },
    "break"
  ]
}
